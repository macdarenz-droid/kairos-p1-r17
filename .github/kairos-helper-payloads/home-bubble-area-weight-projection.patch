+  "reason: 'area-weight-derivation-invalid'",
+  'parseDecimalString(String(entry.metricInput.quoteVolume24h))',
+  'decimalSubtract(quoteVolume, maximumPresentQuoteVolume)',
+  'decimalDivide(quoteVolume, maximumPresentQuoteVolume)',
