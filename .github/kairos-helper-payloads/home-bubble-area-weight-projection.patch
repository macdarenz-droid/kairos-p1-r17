+
+for (const token of [
+  'projectHomeDashboardLiveCryptoBubbleAreaWeights',
+  'HomeDashboardLiveCryptoBubbleAreaWeightProjectionEntry',
+  'areaWeight: DecimalString | null',
+  'presentationStateProjection: SuccessfulPresentationStateProjection',
