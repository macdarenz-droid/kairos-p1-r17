{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kairos-activation",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kairos-activation-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ACTIVATION_RATE_LIMITER",
      "namespace_id": "7001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
