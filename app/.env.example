# Public client configuration only. VITE_ values are visible in the browser bundle.
# npm run build stops unless both activation settings below are set (an https address, a P-256 public key); npm run build:qa uses throwaway ones (D284).
VITE_KAIROS_ACTIVATION_ENDPOINT=https://activation.example.invalid/v1/activate
VITE_KAIROS_ACTIVATION_PUBLIC_KEY_SPKI=REPLACE_WITH_BASE64_SPKI_PUBLIC_KEY
VITE_KAIROS_API_URL=https://kairos-api.example.invalid
